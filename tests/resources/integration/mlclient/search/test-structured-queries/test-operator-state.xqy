import module namespace search="http://marklogic.com/appservices/search" at "/MarkLogic/appservices/search/search.xqy"; import module namespace csu="http://marklogic.com/rest-api/config-query-util" at "/MarkLogic/rest-api/lib/config-query-util.xqy"; declare variable $query external; declare variable $query_json external; let $options := <search:options><search:page-length>10</search:page-length><search:operator name="nresults"><search:state name="few"><search:page-length>2</search:page-length></search:state></search:operator></search:options> for $structured in (xdmp:unquote($query)/*, csu:json-to-xml(xdmp:unquote($query_json))) return xs:int(search:resolve($structured, $options)/@page-length)