{
  "options": {
    "constraint": [
      {
        "name": "price",
        "range": {
          "type": "xs:decimal",
          "facet": true,
          "json-property": "price",
          "fragment-scope": "documents",
          "weight": 2,
          "bucket": [
            {
              "name": "low",
              "ge": "0",
              "lt": "10",
              "label": "Under ten"
            },
            {
              "name": "high",
              "ge": "10",
              "label": "Ten or more"
            }
          ],
          "range-option": [
            "cached"
          ],
          "facet-option": [
            "limit=5"
          ]
        },
        "annotation": [
          "Prices"
        ]
      },
      {
        "name": "created",
        "range": {
          "type": "xs:dateTime",
          "facet": true,
          "json-property": "created",
          "computed-bucket": [
            {
              "name": "today",
              "ge": "P0D",
              "lt": "P1D",
              "anchor": "start-of-day",
              "ge-anchor": "start-of-day",
              "lt-anchor": "start-of-day",
              "label": "Today"
            }
          ]
        }
      }
    ]
  }
}
