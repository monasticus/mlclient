{
  "options": {
    "default-suggestion-source": {
      "ref": "title",
      "word-lexicon": {
        "collation": "http://marklogic.com/collation/",
        "fragment-scope": "documents"
      },
      "suggestion-option": [
        "limit=5"
      ]
    },
    "suggestion-source": [
      {
        "word": {
          "element": {
            "name": "title",
            "ns": ""
          },
          "term-option": [
            "case-insensitive"
          ]
        },
        "ref": "title"
      },
      {
        "collection": {
          "prefix": "https://example.com/tags/",
          "facet": false,
          "facet-option": [
            "limit=4"
          ]
        },
        "ref": "tags"
      },
      {
        "range": {
          "type": "xs:decimal",
          "field": {
            "name": "price"
          }
        },
        "suggestion-option": [
          "ascending"
        ],
        "ref": "prices"
      }
    ]
  }
}
